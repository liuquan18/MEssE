#--------------------------------------------------------------------------------------------------
#
# AMIP experiment with a standalone atmosphere, AES physics, R02B08 on GPUs
# (standard experiment amip-aes-R2B8, Sapphire 2.0 namelist), with a MEssE
# ComIn plugin (ComIn 1.0) that trains a model online.


EXP_TYPE = amip-aes-R2B8
EXP_OPTIONS = suppress_default_output

# Experiments in the out-of-source build directory, <BUILD_DIR>/experiments/<EXP_ID>/
# (mkexp's default derives them from the source directory). The run directory
# (ICON's working directory, where the plugin writes saved_models/ and rf_config_used.yaml,
# and where the output files stay until a chunk finishes) is there too, on /work,
# not on the purged /scratch.
SCRIPT_ROOT = "eval('$BUILD_DIR'.rsplit('/', 1)[0])"
DATA_ROOT = $SCRIPT_ROOT
WORK_ROOT = $DATA_ROOT
MODEL_SUBDIR = "eval('$BUILD_DIR'.rsplit('/', 1)[1])"

INITIAL_DATE = 2020-01-01T00:00:00
FINAL_DATE = 2020-02-01T00:00:00
INTERVAL = P1M

# MEssE settings
MESSE_ROOT = /work/mh0033/m300883/Project_week_global
COMIN_PLUGIN_SCRIPT = $MESSE_ROOT/MEssE/messe/reconstructor_forecaster/plugin.py
MESSE_RF_CONFIG_FILE = $MESSE_ROOT/MEssE/config/fieldspace_rf_r2b8_kv_memory_local_1h.yaml

MESSE_PYTHON = $MESSE_ROOT/ICON/py_env/bin/python3
PYTHON_ADAPTER_DIR = $BUILD_DIR/externals/comin/build/_icon/plugins/python_adapter

[jobs]
  [[run]]
    .trigger =
    nodes = 8
    time_limit = 03:00:00

    [[[env]]]
      COMIN_PYTHON_EXECUTABLE = $MESSE_PYTHON
      MESSE_RF_CONFIG = $MESSE_RF_CONFIG_FILE
      # Open MPI over UCX only: BTL sm fails with ptrace_scope=3 on Levante
      # (since the May 2026 maintenance). The plugin sends CUDA tensors through MPI.
      OMPI_MCA_btl = self
      UCX_RNDV_SCHEME = put_zcopy
      UCX_IB_GPU_DIRECT_RDMA = yes
      UCX_MEMTYPE_CACHE = n

    [[[processes]]]
      [[[[atmo]]]]
        [[[[[env]]]]]
          UCX_TLS = cma, mm, rc, cuda_ipc, cuda_copy, gdr_copy
      [[[[atmo/extra]]]]
        tasks = 3
        tasks_per_node = 1

[namelists]
  [[NAMELIST_atm]]
    [[[parallel_nml]]]
      num_io_procs = 1
      num_restart_procs = 2

    [[[comin_plugin_nml]]]
      name = messe_plugin
      # absolute path: mkexp single-quotes [[[env]]] values, so LD_LIBRARY_PATH cannot be extended there
      plugin_library = $PYTHON_ADAPTER_DIR/libpython_adapter.so
      options = $COMIN_PLUGIN_SCRIPT

    # uas and the plugin's forecast valid at the same time: instantaneous snapshots every
    # 10 minutes, one file per model hour
    [[[output_nml atm_2d_PT10M_ml]]]
      ml_varlist = uas, var_predict
      output_interval = PT10M
      file_interval = PT1H
      operation =

# Place the ranks exactly as listed in the hostfile (work ranks first, then the extra
# tasks). Do not add --nodes: srun rejects it together with --distribution=arbitrary.
[MPI]
  command = srun -l --kill-on-bad-exit=1 --export=ALL --distribution=arbitrary


# ------------------------------------------------------------------------
# Note: When you change the number of GPU nodes you should also
#       change nblocks_c and nblocks_sub to get the best performance.
#       Some values are:
#        * nodes =  8, nblocks_c = 2 & nblocks_sub = 5 (default)
#        * nodes = 16: nblocks_c = 1 & nblocks_sub = 4
#        * nodes >=32: nblocks_c = 1 & nblocks_sub = 1
